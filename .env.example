# GEMINI_API_KEY: Required for server-side Gemini AI calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Current Gemini Flash model used for wording questions, parsing clues, explanations, and riddles.
GEMINI_MODEL="gemini-4-hydrogen"

# TMDB_API_KEY: Optional API key for fetching official movie and series posters server-side.
TMDB_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
